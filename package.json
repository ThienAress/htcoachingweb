    "check:commercial-contracts": "node scripts/check-commercial-contract-boundaries.mjs",
    "test:ops": "node --test scripts/backup-readiness.test.mjs scripts/source-backup.test.mjs scripts/production-monitoring.test.mjs scripts/deployment-identity.test.mjs scripts/release-evidence.test.mjs scripts/release-workflows.test.mjs scripts/dependency-audit-policy.test.mjs scripts/codex-security-scan.test.mjs scripts/docker-contract.test.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
